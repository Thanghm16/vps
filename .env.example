# ================================================================
# BẮT BUỘC TRONG FILE .env / .env.local:
# ================================================================

# 1. MongoDB Connection String (Chỉ duy nhất URL này bắt buộc cấu hình tại file .env)
MONGODB_URI=

# 2. JWT Secrets (Bảo mật phiên đăng nhập và xác thực)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 3. Encryption Secret (Mã hóa credentials nhạy cảm của tài khoản game)
CREDENTIALS_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# 4. Domain ứng dụng
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Google OAuth 2.0 (Đăng nhập bằng Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

